<?xml version="1.0"?>
<materialx version="1.39">
  <nodedef name="ND_g18_rec709_scene_to_lin_rec709_color3" node="g18_rec709_scene_to_lin_rec709_color3" doc="Generated color space g18_rec709_scene to lin_rec709 transform.. OCIO Transforms: (GroupTransform direction=forward, transforms=        (ExponentTransform direction=forward, value=[1.8, 1.8, 1.8, 1], style=pass_thru))">
    <output name="out" type="color3" />
    <input name="in" type="color3" value="0, 0, 0" />
  </nodedef>
  <nodegraph name="NG_g18_rec709_scene_to_lin_rec709_color3" nodedef="ND_g18_rec709_scene_to_lin_rec709_color3">
    <convert name="asVec" type="vector3">
      <input name="in" type="color3" interfacename="in" />
    </convert>
    <!-- Exponent Transform: TransformType.TRANSFORM_TYPE_EXPONENT -->
    <safepower name="exponent" type="vector3">
      <input name="in1" type="vector3" nodename="asVec" />
      <input name="in2" type="vector3" value="1.8, 1.8, 1.8" />
    </safepower>
    <convert name="asColor" type="color3">
      <input name="in" type="vector3" nodename="exponent" />
    </convert>
    <output name="out" type="color3" nodename="asColor" />
  </nodegraph>
</materialx>
