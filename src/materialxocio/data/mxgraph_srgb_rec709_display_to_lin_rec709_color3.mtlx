<?xml version="1.0"?>
<materialx version="1.39">
  <nodedef name="ND_srgb_rec709_display_to_lin_rec709_color3" node="srgb_rec709_display_to_lin_rec709_color3" doc="Generated color space srgb_rec709_display to lin_rec709 transform.. OCIO Transforms: (GroupTransform direction=forward, transforms=        (ExponentWithLinearTransform direction=forward, gamma=[2.4, 2.4, 2.4, 1], offset=[0.055, 0.055, 0.055, 0], style=mirror))">
    <output name="out" type="color3" />
    <input name="in" type="color3" value="0, 0, 0" />
  </nodedef>
  <nodegraph name="NG_srgb_rec709_display_to_lin_rec709_color3" nodedef="ND_srgb_rec709_display_to_lin_rec709_color3">
    <convert name="asVec" type="vector3">
      <input name="in" type="color3" interfacename="in" />
    </convert>
    <!-- Exponent Transform: TransformType.TRANSFORM_TYPE_EXPONENT_WITH_LINEAR -->
    <add name="offset_add" type="vector3">
      <input name="in1" type="vector3" nodename="asVec" />
      <input name="in2" type="vector3" value="0.055, 0.055, 0.055" />
    </add>
    <divide name="offset_div" type="vector3">
      <input name="in1" type="vector3" nodename="offset_add" />
      <input name="in2" type="vector3" value="1.055, 1.055, 1.055" />
    </divide>
    <safepower name="exponent" type="vector3">
      <input name="in1" type="vector3" nodename="offset_div" />
      <input name="in2" type="vector3" value="2.4, 2.4, 2.4" />
    </safepower>
    <convert name="asColor" type="color3">
      <input name="in" type="vector3" nodename="exponent" />
    </convert>
    <output name="out" type="color3" nodename="asColor" />
  </nodegraph>
</materialx>
